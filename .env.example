# Copy this file to .env and fill in your own TMDB credentials.
# Get them at https://www.themoviedb.org/settings/api
# .env is git-ignored; never commit real values.

# API Read Access Token (sent as "Authorization: Bearer ...")
TMDB_TOKEN=your-tmdb-api-read-access-token

# Optional v3 API key, kept only as a fallback; the app and tests use TMDB_TOKEN
TMDB_API_KEY=your-tmdb-v3-api-key

// The home page. Phase 2 shows the active services row with its Edit side sheet; the pick
// itself arrives in phase 3.

import { Theme, Icons } from "../theme.slint";
import { AppButton, Card, FontIcon, PageTitle } from "../widgets.slint";
import { AppState, ServicesState } from "../state.slint";

export component PickPage inherits VerticalLayout {
    padding: 32px;
    spacing: 24px;

    PageTitle {
        title: "What should I watch tonight?";
        subtitle: AppState.region-name == "" ? "" : "Streaming in " + AppState.region-name;
    }

    Card {
        HorizontalLayout {
            padding: 16px;
            spacing: 12px;
            Text {
                text: "Your services";
                color: Theme.text;
                font-weight: 600;
                vertical-alignment: center;
            }
            if ServicesState.active.length == 0: Text {
                text: ServicesState.include-free ? "None selected, so picks come from free titles" : "None selected";
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            for tile in ServicesState.active: Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: tile.logo.width > 0 ? transparent : Theme.hover;
                accessible-role: image;
                accessible-label: tile.name;
                Image {
                    source: tile.logo;
                    width: 32px;
                    height: 32px;
                }
            }
            if ServicesState.active-more > 0: Text {
                text: "+" + ServicesState.active-more;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            if ServicesState.include-free && ServicesState.active.length > 0: Text {
                text: "plus free titles";
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            AppButton {
                text: "Edit";
                icon: Icons.edit;
                accessible-text: "Edit your services";
                clicked => {
                    AppState.open-services-sheet();
                }
            }
        }
    }

    Card {
        vertical-stretch: 1;
        VerticalLayout {
            padding: 32px;
            spacing: 12px;
            alignment: center;
            FontIcon {
                glyph: Icons.shuffle;
                font-size: 40px;
                color: Theme.accent;
            }
            Text {
                text: "Ready when you are";
                font-size: Theme.subtitle;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
            }
            Text {
                text: "The random pick arrives in phase 3. Your region and services are saved and will shape every pick.";
                color: Theme.text-muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if AppState.imdb-status != "": Text {
                text: AppState.imdb-status;
                color: Theme.text-muted;
                font-size: Theme.caption;
                horizontal-alignment: center;
            }
        }
    }
}

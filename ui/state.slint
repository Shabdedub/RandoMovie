// State shared between the Slint UI and Rust. Rust owns the data and sets these
// properties; the UI reports user actions through the callbacks.

export enum Page { pick, search, library, services, settings }

export enum OnboardingStep { token, region, services }

// One service tile. `state`: 0 off, 1 some variants on, 2 on.
export struct ServiceTile {
    key: string,
    name: string,
    logo: image,
    state: int,
    variant-count: int,
}

export struct VariantRow {
    id: int,
    name: string,
    selected: bool,
}

export global AppState {
    in property <bool> onboarding;
    in property <Page> page: Page.pick;
    in property <bool> services-sheet-open;
    in property <bool> offline;
    in property <string> region-name;
    in property <string> imdb-status;
    // Flipped by Rust to force a full repaint (see platform::repaint).
    in property <bool> repaint-tick;
    callback navigate(Page);
    callback open-services-sheet();
    callback close-services-sheet();
    callback open-url(string);
}

export global ServicesState {
    in property <[ServiceTile]> tiles;
    in property <[ServiceTile]> active;
    in property <int> active-more;
    in property <int> hidden-count;
    in property <int> selected-count;
    in property <bool> loading;
    in property <string> error;
    in property <string> empty-message;
    in-out property <bool> include-free: true;
    in property <string> free-hint;
    in-out property <string> filter;
    in property <string> variants-title;
    in property <[VariantRow]> variants;
    callback toggle(string);
    callback open-variants(string);
    callback toggle-variant(int);
    callback filter-edited(string);
    callback show-all();
    callback include-free-toggled(bool);
    callback retry();
}

export global TokenForm {
    in property <bool> checking;
    in property <string> error;
    in property <string> notice;
    in property <bool> dialog-open;
    callback submit(string);
    callback cancel();
}

export global OnboardingState {
    in property <OnboardingStep> step: OnboardingStep.token;
    in property <bool> token-step-shown: true;
    callback next();
    callback back();
    callback finish();
}

// ---- Pick screen and the title card ----------------------------------------------------

export enum PickStatus { idle, picking, shown, failed }

export enum Exclusion { none, seen, not-interested }

export struct GenreOption {
    name: string,
    selected: bool,
}

// One service under "Where to watch".
export struct WatchChip {
    name: string,
    logo: image,
}

// `kind`: 0 on your services, 1 free, 2 other subscriptions, 3 rent or buy.
export struct WatchGroup {
    label: string,
    kind: int,
    chips: [WatchChip],
}

// The title card's text. Shared by Pick and (from phase 4) Search.
export struct TitleCardData {
    name: string,
    year: string,
    kind: string,
    facts: string,
    overview: string,
    // "8.7 IMDb · 2.3M votes" (the star is drawn as an icon), or the unavailable/loading text.
    imdb: string,
    // 0 rated, 1 unavailable, 2 loading
    imdb-state: int,
    verdict: string,
    // 0 on your services, 1 free, 2 not on your services, 3 not streaming in the region
    verdict-state: int,
    region-name: string,
    link: string,
}

export global PickState {
    // Filter bar
    in-out property <int> media-index: 2;
    in property <[GenreOption]> genres;
    in property <string> genre-summary: "Any genre";
    in property <string> genre-note;
    in property <[string]> rating-options;
    in-out property <int> rating-index;
    in property <[string]> votes-options;
    in-out property <int> votes-index;
    in property <string> imdb-summary;
    in property <bool> imdb-filtered;
    in-out property <string> year-from;
    in-out property <string> year-to;
    in property <string> year-summary: "Any year";
    in property <string> year-error;
    // The decade chip matching the year range, or -1.
    in property <int> decade-index: -1;
    in property <[string]> runtime-options;
    in-out property <int> runtime-index;
    in property <string> runtime-summary: "Any length";
    in property <bool> runtime-applies: true;
    in property <bool> filters-changed;

    // The pick
    in property <PickStatus> status: PickStatus.idle;
    in property <bool> busy;
    in property <bool> has-picked;
    in property <TitleCardData> card;
    // Changes with every new title.
    in property <int> card-serial;
    in property <[WatchGroup]> groups;
    in property <image> poster;
    in property <image> backdrop;
    in property <bool> can-go-back;
    in property <Exclusion> excluded;
    in property <string> idle-message;
    in property <string> error-title;
    in property <string> error-message;
    in property <string> error-action;
    // Announced to screen readers when a pick arrives or fails.
    in property <string> announcement;

    callback pick();
    callback previous();
    // `Exclusion.none` undoes "Seen it" or "Not interested".
    callback exclude(Exclusion);
    callback media-selected(int);
    callback genre-toggled(int);
    callback genres-cleared();
    callback rating-selected(int);
    callback votes-selected(int);
    callback years-edited(string, string);
    callback decade-chosen(int);
    callback runtime-selected(int);
    callback reset-filters();
    callback run-error-action();
    callback open-where-to-watch();
    // The card's size and its poster's, in logical pixels, whenever they change.
    callback card-resized(length, length, length, length);
}

// ---- Search ------------------------------------------------------------------------------

export enum SearchStatus { idle, searching, results, empty, failed }

// One search result. `imdb-state`: 0 rated, 1 unavailable, 2 loading.
// `verdict-state`: 0 on your services, 1 free, 2 not on your services, 3 not streaming in the
// region, 4 loading, 5 couldn't load.
export struct SearchRow {
    name: string,
    meta: string,
    thumb: image,
    imdb: string,
    imdb-state: int,
    verdict: string,
    verdict-state: int,
}

export global SearchState {
    in-out property <string> text;
    in property <SearchStatus> status: SearchStatus.idle;
    in property <[SearchRow]> rows;
    in-out property <int> selected: -1;
    in property <string> heading;
    in property <string> intro;
    in property <string> message;
    // A newer search is running while the previous results still show.
    in property <bool> searching;
    in property <bool> has-more;
    in property <bool> loading-more;
    // Bumped by Ctrl+F to put the cursor in the search box.
    in-out property <int> focus-request;
    // Bumped for each new query's results, to scroll the list back to the top.
    in-out property <int> results-serial;

    // The opened result, shown over the list, which keeps its place.
    in property <bool> card-open;
    in property <bool> card-loading;
    in property <string> card-error;
    in property <TitleCardData> card;
    in property <int> card-serial;
    in property <[WatchGroup]> groups;
    in property <image> poster;
    in property <image> backdrop;
    in property <string> announcement;

    callback edited(string);
    callback submitted();
    callback open(int);
    callback close-card();
    callback load-more();
    callback retry();
    callback open-where-to-watch();
    callback card-resized(length, length, length, length);
}

// ---- Library -----------------------------------------------------------------------------

// One title in the Library. `pending`: its name and poster are still loading (a title marked
// before the Library existed).
export struct LibraryRow {
    name: string,
    meta: string,
    thumb: image,
    // "7.3 IMDb · 198K votes" (the star is drawn as an icon), or empty.
    imdb: string,
    marked: string,
    pending: bool,
}

export global LibraryState {
    // 0 Watched (marked "Seen it"), 1 Not interested.
    in-out property <int> tab;
    in property <[string]> tabs: ["Watched", "Not interested"];
    in property <[LibraryRow]> rows;
    in-out property <int> selected: -1;
    // Until the first list arrives, so the empty message doesn't flash.
    in property <bool> loading: true;
    // What the last removal or move did, with Undo.
    in property <string> notice;
    in property <bool> can-undo;
    // Bumped when the tab or a filter changes, to scroll the list back to the top.
    in-out property <int> list-serial;

    // Filters for both lists: 0 Movies, 1 Series, 2 Both; and genres, where any chosen one
    // matches.
    in-out property <int> media-index: 2;
    in property <[GenreOption]> genres;
    in property <string> genre-summary: "Any genre";
    // A filter is set, so "Clear filters" shows.
    in property <bool> filtered;

    // The opened title, shown over the list, which keeps its place.
    in property <bool> card-open;
    in property <bool> card-loading;
    in property <string> card-error;
    in property <TitleCardData> card;
    in property <int> card-serial;
    in property <[WatchGroup]> groups;
    in property <image> poster;
    in property <image> backdrop;
    in property <string> announcement;

    callback tab-selected(int);
    callback media-selected(int);
    callback genre-toggled(int);
    callback genres-cleared();
    callback clear-filters();
    callback open(int);
    // Takes the title off its list, so it can be picked again.
    callback remove(int);
    // The same for the opened title, and moving it to the other list.
    callback remove-open();
    callback move-open();
    callback undo();
    callback close-card();
    callback open-where-to-watch();
    callback card-resized(length, length, length, length);
}

export global SettingsState {
    in property <[string]> region-names;
    in-out property <int> region-index;
    in property <string> detected-region;
    in-out property <int> theme-index;
    in-out property <int> media-index;
    in-out property <bool> include-free: true;
    in property <[string]> floor-options;
    in-out property <int> floor-index;
    in property <string> cache-size;
    in property <bool> clearing-cache;
    in property <string> imdb-summary;
    in property <string> imdb-message;
    in property <bool> imdb-refreshing;
    in property <string> token-source;
    in property <bool> token-removable;
    in property <string> version;
    callback region-selected(int);
    callback theme-selected(int);
    callback media-selected(int);
    callback include-free-toggled(bool);
    callback floor-selected(int);
    callback clear-cache();
    callback refresh-imdb();
    callback change-token();
    callback remove-token();
}

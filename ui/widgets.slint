// Small building blocks styled with the design tokens. Interactive ones are keyboard
// operable (Tab to focus, Space or Enter to activate) and show a focus ring only when
// focus came from the keyboard.

import { Spinner } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";

// A glyph from the icon font. Icons are decorative (the control or text beside them carries the
// name), so screen readers skip them. The glyph is a child rather than the root because Slint
// only honours `accessible-role: none` on the element that sets it: set on the root, every
// FontIcon would still show up to screen readers as an unnamed node.
export component FontIcon {
    in property <string> glyph;
    in property <color> color: Theme.text;
    in property <length> font-size: 16px;
    in property <TextVerticalAlignment> vertical-alignment: TextVerticalAlignment.center;
    // Icons keep their size in layouts; text beside them takes the spare room.
    horizontal-stretch: 0;
    vertical-stretch: 0;
    min-width: glyph-text.min-width;
    min-height: glyph-text.min-height;
    preferred-width: glyph-text.preferred-width;
    preferred-height: glyph-text.preferred-height;

    glyph-text := Text {
        width: 100%;
        height: 100%;
        text: root.glyph;
        font-family: Theme.icon-font;
        font-size: root.font-size;
        color: root.color;
        horizontal-alignment: center;
        vertical-alignment: root.vertical-alignment;
        accessible-role: none;
    }
}

export enum ButtonKind { primary, secondary, subtle, danger }

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <ButtonKind> kind: ButtonKind.secondary;
    in property <bool> enabled: true;
    in property <bool> busy;
    in property <string> accessible-text: root.text;
    callback clicked();

    property <bool> active: root.enabled && !root.busy;
    property <bool> primary: root.kind == ButtonKind.primary;
    property <color> ink: !root.enabled ? Theme.text-disabled
        : root.primary ? Theme.on-accent
        : root.kind == ButtonKind.danger ? Theme.danger
        : Theme.text;

    min-width: max(32px, content.min-width);
    min-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius-control;
    border-width: root.kind == ButtonKind.secondary ? 1px : 0px;
    border-color: Theme.border-strong;
    background: !root.enabled ? (root.primary ? Theme.hover : transparent)
        : touch.pressed ? (root.primary ? Theme.accent.darker(0.15) : Theme.pressed)
        : touch.has-hover ? (root.primary ? Theme.accent-hover : Theme.hover)
        : root.primary ? Theme.accent
        : root.kind == ButtonKind.secondary ? Theme.raised
        : transparent;
    animate background { duration: 120ms; }

    accessible-role: button;
    accessible-label: root.accessible-text;
    accessible-enabled: root.active;
    accessible-action-default => {
        if (root.active) {
            root.clicked();
        }
    }

    focus := FocusScope {
        enabled: root.active;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            reject
        }
        touch := TouchArea {
            enabled: root.active;
            mouse-cursor: root.active ? MouseCursor.pointer : MouseCursor.default;
            clicked => {
                root.clicked();
            }
        }
    }

    content := HorizontalLayout {
        padding-left: root.text == "" ? 8px : 14px;
        padding-right: root.text == "" ? 8px : 14px;
        spacing: 8px;
        alignment: center;
        if root.busy: Spinner {
            width: 16px;
            height: 16px;
            indeterminate: true;
        }
        if root.icon != "" && !root.busy: FontIcon {
            glyph: root.icon;
            color: root.ink;
            font-size: 14px;
        }
        // The button itself carries the name; screen readers needn't read it twice.
        if root.text != "": Text {
            text: root.text;
            color: root.ink;
            font-weight: root.primary ? 600 : 400;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: root.border-radius + 3px;
        border-width: 2px;
        border-color: Theme.accent;
        visible: focus.has-focus;
    }
}

// A text link that opens in the browser (the caller handles `clicked`).
export component LinkButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    min-width: row.min-width;
    min-height: 24px;
    horizontal-stretch: 0;
    border-radius: 4px;
    accessible-role: button;
    accessible-label: root.text + " (opens in your browser)";
    accessible-action-default => {
        root.clicked();
    }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            reject
        }
        touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.clicked();
            }
        }
    }
    row := HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Text {
            text: root.text;
            color: touch.has-hover ? Theme.accent-hover : Theme.accent;
            vertical-alignment: center;
            accessible-role: none;
        }
        FontIcon {
            glyph: Icons.open-link;
            font-size: 12px;
            color: touch.has-hover ? Theme.accent-hover : Theme.accent;
        }
    }
    Rectangle {
        x: -3px;
        y: -1px;
        width: root.width + 6px;
        height: root.height + 2px;
        border-radius: 4px;
        border-width: 2px;
        border-color: Theme.accent;
        visible: focus.has-focus;
    }
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border;
}

export component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 4px;
    Text {
        text: root.title;
        font-size: Theme.title;
        font-weight: 600;
        color: Theme.text;
        accessible-role: AccessibleRole.text;
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}

// A labelled row in a settings card; the control goes in as a child.
export component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            color: Theme.text;
            wrap: word-wrap;
        }
        if root.description != "": Text {
            text: root.description;
            color: Theme.text-muted;
            font-size: Theme.caption;
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        horizontal-stretch: 0;
        @children
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// A row of mutually exclusive choices. Left and Right arrows move the selection.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    in property <string> label;
    callback changed(int);

    height: 32px;
    min-width: row.min-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-control;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: radio-group;
    accessible-label: root.label;
    // Screen readers put focus on the selected option, not on the group.
    accessible-delegate-focus: root.selected;
    forward-focus: focus;

    function choose(index: int) {
        if (index >= 0 && index < root.options.length && index != root.selected) {
            root.selected = index;
            root.changed(index);
        }
    }

    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.RightArrow) {
                root.choose(root.selected + 1);
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.choose(root.selected - 1);
                return accept;
            }
            reject
        }
    }

    row := HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for option[index] in root.options: Rectangle {
            min-width: label-text.min-width + 28px;
            border-radius: Theme.radius-control - 2px;
            background: index == root.selected ? Theme.surface
                : option-touch.has-hover ? Theme.hover
                : transparent;
            border-width: index == root.selected ? 1px : 0px;
            border-color: Theme.border-strong;
            accessible-role: radio-button;
            accessible-label: option;
            accessible-checked: index == root.selected;
            accessible-action-default => {
                root.choose(index);
            }
            label-text := Text {
                text: option;
                color: index == root.selected ? Theme.text : Theme.text-muted;
                font-weight: index == root.selected ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
            option-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.choose(index);
                }
            }
        }
    }

    Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: root.border-radius + 3px;
        border-width: 2px;
        border-color: Theme.accent;
        visible: focus.has-focus;
    }
}

// An inline, non-blocking message with an optional action such as "Retry".
export component InlineMessage inherits Rectangle {
    in property <string> text;
    in property <bool> is-error: true;
    in property <string> action-text;
    callback action();
    border-radius: Theme.radius-control;
    background: root.is-error ? Theme.danger-subtle : Theme.warning-subtle;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    accessible-live-region: AccessibleLiveness.polite;
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        FontIcon {
            glyph: root.is-error ? Icons.error : Icons.warning;
            color: root.is-error ? Theme.danger : Theme.warning;
            vertical-alignment: top;
        }
        Text {
            text: root.text;
            color: Theme.text;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.action-text != "": AppButton {
            text: root.action-text;
            clicked => {
                root.action();
            }
        }
    }
}

// A centred message in a list's place: before searching, an empty list, or an error.
export component Notice inherits VerticalLayout {
    in property <string> icon;
    in property <string> title;
    in property <string> body;
    in property <string> action;
    // Problems get a muted icon, as on the Pick page; prompts keep the accent.
    in property <bool> problem;
    callback act();
    alignment: center;
    spacing: 12px;
    padding: 32px;
    FontIcon {
        glyph: root.icon;
        font-size: 40px;
        color: root.problem ? Theme.text-muted : Theme.accent;
    }
    Text {
        text: root.title;
        font-size: Theme.subtitle;
        font-weight: 600;
        color: Theme.text;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.body != "": Text {
        text: root.body;
        color: Theme.text-muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.action != "": HorizontalLayout {
        alignment: center;
        AppButton {
            text: root.action;
            clicked => {
                root.act();
            }
        }
    }
}

// A static placeholder block shown while content loads (no shimmer: nothing animates idle).
// Screen readers skip it: a plain Rectangle isn't exposed (see FontIcon for why it doesn't set
// `accessible-role: none`).
export component Skeleton inherits Rectangle {
    background: Theme.hover;
    border-radius: 6px;
}

// A text-only button in the accent colour, for "More", "Undo" and similar.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> accessible-text: root.text;
    // False for a button repeated on every row of a list, which offers the same action from
    // the keyboard, so Tab doesn't stop on each one.
    in property <bool> tab-stop: true;
    callback clicked();

    min-width: row.min-width;
    min-height: 24px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 4px;
    accessible-role: button;
    accessible-label: root.accessible-text;
    accessible-action-default => {
        root.clicked();
    }

    focus := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: root.tab-stop;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            reject
        }
        touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.clicked();
            }
        }
    }

    row := HorizontalLayout {
        spacing: 4px;
        alignment: start;
        Text {
            text: root.text;
            color: touch.has-hover ? Theme.accent-hover : Theme.accent;
            font-weight: 600;
            vertical-alignment: center;
            accessible-role: none;
        }
        if root.icon != "": FontIcon {
            glyph: root.icon;
            font-size: 11px;
            color: touch.has-hover ? Theme.accent-hover : Theme.accent;
        }
    }

    Rectangle {
        x: -3px;
        y: -1px;
        width: root.width + 6px;
        height: root.height + 2px;
        border-radius: 4px;
        border-width: 2px;
        border-color: Theme.accent;
        visible: focus.has-focus;
    }
}

// A small rounded label, such as the Movie / Series badge.
export component Pill inherits Rectangle {
    in property <string> text;
    width: label.preferred-width + 16px;
    height: 22px;
    border-radius: 11px;
    background: Theme.accent-subtle;
    label := Text {
        text: root.text;
        font-size: Theme.caption;
        font-weight: 600;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A filter in the filter bar: shows the current choice and opens its panel.
export component FilterButton inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    // What the filter is, for screen readers: "Genres", "IMDb minimum", ...
    in property <string> label;
    // True when the filter narrows the picks, so it stands out.
    in property <bool> active;
    callback clicked();

    height: 32px;
    min-width: row.min-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border-strong;
    background: touch.pressed ? Theme.pressed
        : touch.has-hover ? Theme.hover
        : root.active ? Theme.accent-subtle
        : Theme.raised;
    animate background { duration: 120ms; }

    accessible-role: button;
    accessible-label: root.label + ": " + root.text;
    accessible-action-default => {
        root.clicked();
    }

    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow) {
                root.clicked();
                return accept;
            }
            reject
        }
        touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.clicked();
            }
        }
    }

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        FontIcon {
            glyph: root.icon;
            font-size: 14px;
            color: root.active ? Theme.accent : Theme.text-muted;
        }
        Text {
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
            accessible-role: none;
        }
        FontIcon {
            glyph: Icons.chevron-down;
            font-size: 10px;
            color: Theme.text-muted;
        }
    }

    Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: root.border-radius + 3px;
        border-width: 2px;
        border-color: Theme.accent;
        visible: focus.has-focus;
    }
}

// A rounded on/off chip, such as a genre in the genre filter.
export component ToggleChip inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback toggled();

    height: 30px;
    width: row.preferred-width;
    border-radius: 15px;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : Theme.border-strong;
    background: touch.pressed ? Theme.pressed
        : touch.has-hover ? Theme.hover
        : root.checked ? Theme.accent-subtle
        : transparent;

    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.toggled();
    }
    forward-focus: focus;

    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.toggled();
                return accept;
            }
            reject
        }
        touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.toggled();
            }
        }
    }

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        if root.checked: FontIcon {
            glyph: Icons.check;
            font-size: 11px;
            color: Theme.accent;
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: root.border-radius + 3px;
        border-width: 2px;
        border-color: Theme.accent;
        visible: focus.has-focus;
    }
}
